# Copiar como .env para desarrollo local — NUNCA commitear valores reales.
# En Vercel estas mismas variables se configuran en Project → Settings → Environment Variables.

# Service Account JSON completo (estructura ficticia de ejemplo, sin valores reales)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"streamcontrol-10837","private_key_id":"","private_key":"","client_email":"","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":""}

# Bot de Telegram
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# SMTP (nodemailer)
SMTP_USER=
SMTP_PASS=

# Secreto para invocar endpoints cron desde GH Actions (header x-cron-secret)
CRON_SECRET=

# URL pública de la app (opcional, default: streamcontrol-10837.firebaseapp.com)
APP_URL=https://streamcontrol-10837.firebaseapp.com