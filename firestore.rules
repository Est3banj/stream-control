rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // FUNCIONES AUXILIARES
    // ============================================
    
    // Verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Obtener el UID del usuario autenticado
    function getUserId() {
      return request.auth.uid;
    }
    
    // Obtener el email del usuario autenticado
    function getUserEmail() {
      return request.auth.token.email;
    }
    
    // Verificar si el usuario es administrador (Token Custom Claim o rol en doc usuarios)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == 'admin') ||
        (request.auth.token.admin == true) ||
        (
          exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
        )
      );
    }
    
    // ============================================
    // COLECCIÓN: usuarios
    // ============================================
    match /usuarios/{userId} {
      // Lectura: Usuario puede leer su propio documento, admin puede leer todos
      allow read: if isAuthenticated() && (
        userId == getUserId() || 
        isAdmin()
      );
      
      // Creación: Admin puede crear cualquier usuario, o el usuario se auto-registra
      allow create: if isAuthenticated() && (
        // Admin puede crear usuarios con cualquier rol
        isAdmin() ||
        // Auto-registro: el usuario crea su propio perfil (solo como 'usuario')
        (userId == getUserId() &&
          request.resource.data.rol == 'usuario' &&
          request.resource.data.estado == 'activo' &&
          request.resource.data.nombre is string &&
          request.resource.data.correo is string
        )
      );
      
      // Actualización: Admin puede actualizar cualquier campo;
      // usuario actualiza su propio nombre, correo, moneda y tasa
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (userId == getUserId() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'correo', 'moneda', 'tasa']) &&
          request.resource.data.nombre is string &&
          (request.resource.data.correo == null || request.resource.data.correo is string)
        )
      );

      // Eliminación: Solo admin
      allow delete: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: ventas
    // ============================================
    match /ventas/{ventaId} {
      // Lectura: Usuario puede leer sus propias ventas, admin puede leer todas
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.propietarioId == getUserId()
      );
      
      // Creación: Cualquier usuario autenticado puede crear ventas propias, o admin
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.propietarioId == getUserId() &&
          request.resource.data.usuarioEmail == getUserEmail() &&
          request.resource.data.nombre is string &&
          request.resource.data.telefono is string &&
          request.resource.data.plataforma is string &&
          request.resource.data.pantallas is number &&
          request.resource.data.pantallas >= 1 &&
          request.resource.data.precioVenta is number &&
          request.resource.data.precioVenta >= 0 &&
          request.resource.data.costoServicio is number &&
          request.resource.data.costoServicio >= 0 &&
          request.resource.data.utilidad is number &&
          request.resource.data.fechaInicio is string &&
          request.resource.data.diasServicio is number &&
          request.resource.data.diasServicio >= 1 &&
          request.resource.data.fechaVencimiento is string &&
          (request.resource.data.correo == null || request.resource.data.correo is string)
        )
      );

      // Actualización / Eliminación: Solo admin
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: clientes
    // ============================================
    match /clientes/{clienteId} {
      // Lectura: Usuario puede leer sus propios clientes, admin puede leer todos
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && resource.data.propietarioId == getUserId())
      );
      
      // Creación: Admin o propietario creando con prefijo `${userId}_`
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          clienteId.matches('^' + getUserId() + '_.+') &&
          request.resource.data.propietarioId == getUserId() &&
          request.resource.data.usuarioEmail == getUserEmail() &&
          request.resource.data.nombre is string &&
          request.resource.data.telefono is string &&
          request.resource.data.plataforma is string &&
          request.resource.data.estado == 'activo' &&
          request.resource.data.fechaVencimiento is string &&
          (request.resource.data.correo == null || request.resource.data.correo is string)
        )
      );
      
      // Actualización: Admin puede actualizar cualquier cliente, propietario sus propios clientes
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (clienteId.matches('^' + getUserId() + '_.+') &&
          resource.data.propietarioId == getUserId() &&
          (
            // Caso 1: setDoc completo o con merge desde VentasForm
            (
              request.resource.data.propietarioId == getUserId() &&
              request.resource.data.usuarioEmail == getUserEmail() &&
              request.resource.data.nombre is string &&
              request.resource.data.telefono is string &&
              request.resource.data.plataforma is string &&
              request.resource.data.estado == 'activo' &&
              request.resource.data.fechaVencimiento is string &&
              (request.resource.data.correo == null || request.resource.data.correo is string)
            ) ||
            // Caso 2: updateDoc parcial desde GestionClientes (solo campos editables)
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'telefono', 'correo', 'plataforma']) &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nombre']) || request.resource.data.nombre is string) &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['telefono']) || request.resource.data.telefono is string) &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plataforma']) || request.resource.data.plataforma is string) &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['correo']) || (request.resource.data.correo == null || request.resource.data.correo is string))
            ) ||
            // Caso 3: updateDoc de saldoPendiente (increment desde VentasForm / cobro en GestionClientes)
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saldoPendiente']) &&
              request.resource.data.saldoPendiente is number
            ) ||
            // Caso 4: updateDoc de cuentaId/perfilAsignado (asignar/desasignar perfil)
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cuentaId', 'perfilAsignado']) &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cuentaId']) || request.resource.data.cuentaId is string) &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['perfilAsignado']) || request.resource.data.perfilAsignado is string)
            )
          )
        )
      );
      
      // Eliminación: Solo admin
      allow delete: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: movimientos
    // ============================================
    match /movimientos/{movimientoId} {
      // Lectura: Usuario puede leer sus propios movimientos, admin puede leer todos
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.propietarioId == getUserId()
      );
      
      // Creación: Cualquier usuario autenticado puede crear movimientos propios, o admin
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.propietarioId == getUserId() &&
          request.resource.data.usuarioEmail == getUserEmail() &&
          request.resource.data.tipo in ['Ingreso', 'Egreso'] &&
          request.resource.data.monto is number &&
          request.resource.data.monto >= 0 &&
          request.resource.data.descripcion is string &&
          (request.resource.data.fecha == null || request.resource.data.fecha is timestamp)
        )
      );
      
      // Actualización / Eliminación: Solo admin
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: codigosVinculacion (Telegram)
    // ============================================
    match /codigosVinculacion/{codigo} {
      // Solo admin (Cloud Function) puede leer códigos
      allow read: if isAdmin();
      // Solo el usuario autenticado puede crear su propio código
      allow create: if isAuthenticated() &&
        request.resource.data.uid == getUserId() &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expirado == false;
      // Solo el admin (Cloud Function) puede marcar como expirado
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expirado']);
      allow delete: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: vinculaciones (Telegram)
    // ============================================
    match /vinculaciones/{chatId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.uid == getUserId());
      allow write: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: planes
    // ============================================
    match /planes/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: suscripciones
    // ============================================
    match /suscripciones/{suscripcionId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && resource.data.usuarioId == getUserId())
      );
      allow write: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: anunciosGlobales
    // ============================================
    match /anunciosGlobales/{anuncioId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // COLECCIÓN: config
    // ============================================
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // COLECCIÓN: configuracion
    // ============================================
    match /configuracion/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // COLECCIÓN: notificacionesEmail
    // ============================================
    match /notificacionesEmail/{docId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    
    // ============================================
    // COLECCIÓN: cuentas
    // ============================================
    match /cuentas/{cuentaId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.propietarioId == getUserId() ||
        (resource.data.usuarioId != null && resource.data.usuarioId == getUserId())
      );

      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.propietarioId == getUserId() &&
          request.resource.data.proveedor is string &&
          request.resource.data.costo is number &&
          request.resource.data.tipoVenta is string &&
          request.resource.data.tipoVenta in ['perfiles', 'completa'] &&
          request.resource.data.perfiles is list &&
          (request.resource.data.tipoVenta == 'completa' || request.resource.data.perfiles.size() > 0) &&
          request.resource.data.estado is string &&
          request.resource.data.estado in ['disponible', 'asignada', 'expirada']
        )
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.propietarioId == getUserId()
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // COLECCIÓN: cuentas_secretos
    // ============================================
    // ACCESO TOTALMENTE DENEGADO desde cliente.
    // Solo Cloud Functions vía Admin SDK pueden leer/escribir.
    match /cuentas_secretos/{docId} {
      allow read, write: if false;
    }

    // ============================================
    // COLECCIÓN: notificaciones
    // ============================================
    // Solo la cron (Admin SDK) puede escribir notificaciones.
    // Lectura solo para admins (panel de notificaciones).
    match /notificaciones/{notifId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // COLECCIÓN: tokens
    // ============================================
    match /tokens/{tokenId} {
      // Lectura pública: cualquiera puede leer un token (para validarlo)
      allow read: if true;
      // Mutaciones solo por Cloud Functions (Admin SDK)
      allow write: if false;
    }

    // ============================================
    // COLECCIÓN: otpsVerificacion
    // ============================================
    // Solo Cloud Functions vía Admin SDK pueden leer/escribir códigos OTP.
    match /otpsVerificacion/{docId} {
      allow read, write: if false;
    }

    // ============================================
    // DENEGAR ACCESO A OTRAS COLECCIONES
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
